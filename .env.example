# PEPPACORP LICITA — copie para .env.local e preencha. Reinicie o servidor (npm run dev) depois de mudar.
# Tudo vazio = modo demonstração (dados no navegador, sem login).

# ===== Supabase (Project Settings → API) =====
# URL do projeto, ex.: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon" (pode ir para o navegador; o acesso é protegido por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" — SÓ no servidor. Usada pela rota que recebe o chat da extensão.
# Nunca coloque em variável NEXT_PUBLIC_ nem compartilhe.
SUPABASE_SERVICE_ROLE_KEY=

# ===== IA (opcional) =====
# Claude, chave do servidor. Sem ela, escolha o Google Gemini em Configurações → Inteligência artificial
# (a chave do Gemini fica salva na conta da empresa, não aqui).
ANTHROPIC_API_KEY=
